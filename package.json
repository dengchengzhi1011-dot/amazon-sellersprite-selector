{
  "name": "amazon-sellersprite-selector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-bridge.mjs",
    "dev:ui": "vite",
    "bridge": "node scripts/sellersprite-bridge.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "validate:new-product-sales": "node scripts/validate-new-product-sales-signal.mjs",
    "validate:mcp-flow": "node scripts/validate-mcp-validation-flow.mjs",
    "validate:discovery-layout": "node scripts/validate-discovery-layout.mjs",
    "validate:navigation": "node scripts/validate-navigation.mjs",
    "audit:security": "npm audit --omit=dev",
    "audit:all": "npm run validate:mcp-flow && npm run validate:new-product-sales && npm run validate:discovery-layout && npm run validate:navigation && npm run typecheck && npm run build && npm run audit:security",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7"
  }
}
